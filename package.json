{
  "name": "dsh-active-sessions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Active sessions window (left sidebar) + Work Overview tab for DSH Web GUI. Read-only, zero model tokens.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.0.1",
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT"
}
